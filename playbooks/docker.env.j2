# templates/docker.env.j2
# Rendered by deploy-be.yml from secrets stored in `pass` (encrypted on disk).
# This template lives in git; the values it interpolates do NOT.

# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

ERPNEXT_VERSION=v16.27.0

# Secrets (★ sourced from `pass` via community.general.passwordstore lookup)
DB_PASSWORD={{ db_password }}
HASHED_PASSWORD={{ traefik_basicauth }}
SITES_RULE=HostRegexp(`{subdomain:[a-z0-9-]+}.pitaas.rtcnexora.com`)
ROUTER={{ router }}
LETSENCRYPT_EMAIL={{ letsencrypt_email }}
EMAIL={{ letsencrypt_email }}
TRAEFIK_DOMAIN=traefik.pitaas.rtcnexora.com

# Path locations for the multi-bench overlay
DB_DATA_LOCATION={{ db_data_location }}
SITES_DATA_LOCATION={{ sites_data_location }}
REDIS_QUEUE_DATA_LOCATION={{ redis_queue_data_location }}
BENCH_NETWORK={{ bench_network }}

# Static config (no secrets; safe to commit)
FRAPPE_SITE_NAME_HEADER={{ frappe_site_name_header }}
HTTP_PUBLISH_PORT=8080
HTTPS_PUBLISH_PORT=8000
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Empty placeholders for optional vars (compose will not error)
DB_HOST=
DB_PORT=
DB_PASSWORD_SECRETS_FILE=
REDIS_CACHE=
REDIS_QUEUE=
DB_NAME=
DB_USER=
UPSTREAM_REAL_IP_ADDRESS=
UPSTREAM_REAL_IP_HEADER=
UPSTREAM_REAL_IP_RECURSIVE=
PROXY_READ_TIMEOUT=
CLIENT_MAX_BODY_SIZE=
MIGRATE_SITES=true
PULL_POLICY=always
RESTART_POLICY=unless-stopped
BACKUP_CRONSTRING=@every 6h
NGINX_LISTEN_PORT=8080
NGINX_PROXY_HOSTS=erp.example.com
